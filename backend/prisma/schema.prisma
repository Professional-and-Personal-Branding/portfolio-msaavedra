// Prisma Schema — Portafolio Administrable Manuel Saavedra
// Datasource: PostgreSQL · ver docs/ARCHITECTURE.md para contexto
//
// NOTA DE ARQUITECTURA (Clean Architecture):
// Estos modelos son la representación de PERSISTENCIA (infrastructure layer).
// NO deben usarse directamente como entidades de dominio. Cada repositorio
// Prisma en infrastructure/persistence/ debe mapear estos modelos a las
// entidades de dominio (domain/entities) y viceversa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// PERFIL BASE
// ─────────────────────────────────────────────────────────────
model Profile {
  id                String   @id @default(cuid())
  fullName          String
  headline          Json     // LocalizedText { es, en }
  location          String
  timezone          String   @default("GMT-4")
  email             String
  phone             String?
  summary           Json     // LocalizedText { es, en }
  yearsOfExperience Int      @default(0)

  // Disponibilidad (embebida como campos simples; traducibles)
  availModality     Json?    // LocalizedText
  availContractType Json?    // LocalizedText
  availStartDate    Json?    // LocalizedText

  languages         Language[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Language {
  id        String  @id @default(cuid())
  name      String  // nombre del idioma (no se traduce: "Español"/"Spanish" se maneja como LocalizedText si se desea)
  nameI18n  Json?   // opcional LocalizedText para el nombre mostrado
  level     Json    // LocalizedText (o string legado)
  detail    Json?   // LocalizedText
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
}

// ─────────────────────────────────────────────────────────────
// EXPERIENCIA LABORAL
// ─────────────────────────────────────────────────────────────
model Experience {
  id           String   @id @default(cuid())
  company      String                    // no traducible
  role         Json                      // LocalizedText
  startDate    String   // formato YYYY-MM
  endDate      String?  // null = actual
  current      Boolean  @default(false)
  location     String                    // no traducible
  summary      Json                      // LocalizedText
  highlights   Json                      // LocalizedList { es: string[], en: string[] }
  technologies String[]                  // no traducible
  tags         String[]                  // ⭐ filtrado de perfiles curados (no traducible)
  sector       String[]                  // no traducible
  order        Int      @default(0)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([order])
}

// ─────────────────────────────────────────────────────────────
// SKILLS
// ─────────────────────────────────────────────────────────────
model SkillCategory {
  id        String   @id @default(cuid())
  name      Json     // LocalizedText { es, en }
  order     Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now())

  @@index([order])
}

model Skill {
  id         String        @id @default(cuid())
  name       String
  tags       String[]      // ⭐ usados por el filtrado de perfiles curados
  order      Int           @default(0)
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
}

// ─────────────────────────────────────────────────────────────
// EDUCACIÓN Y CERTIFICACIONES
// ─────────────────────────────────────────────────────────────
model Education {
  id          String   @id @default(cuid())
  degree      Json     // LocalizedText { es, en }
  institution String                    // no traducible
  startDate   String
  endDate     String?
  inProgress  Boolean  @default(false)
  order       Int      @default(0)
  visible     Boolean  @default(true)

  @@index([order])
}

model Certification {
  id        String   @id @default(cuid())
  name      Json     // LocalizedText { es, en }
  issuer    String                      // no traducible
  year      String?
  verificationUrl String?                 // https absoluta, <= 2048; no traducible
  credentialId    String?                 // texto plano, <= 100; no traducible
  expiresAt       String?                 // AAAA-MM o AAAA; no traducible
  order     Int      @default(0)
  visible   Boolean  @default(true)

  @@index([order])
}

// ─────────────────────────────────────────────────────────────
// PROYECTOS DESTACADOS
// ─────────────────────────────────────────────────────────────
model Project {
  id           String   @id @default(cuid())
  name         String                    // no traducible
  role         Json                      // LocalizedText
  period       String
  summary      Json                      // LocalizedText
  technologies String[]                  // no traducible
  tags         String[]                  // ⭐ filtrado (no traducible)
  url          String?
  order        Int      @default(0)
  visible      Boolean  @default(true)

  @@index([order])
}

// ─────────────────────────────────────────────────────────────
// REDES Y PRESENCIA PÚBLICA (GitHub, YouTube, etc.)
// ─────────────────────────────────────────────────────────────
model SocialLink {
  id          String   @id @default(cuid())
  platform    String                      // 'github' | 'youtube' | 'linkedin' | ...
  handle      String                      // ej. 'manuXD270516' o '@manueljoaquinsaavedrasever8888'
  url         String
  label       Json                        // LocalizedText — texto corto (ej. "Código y proyectos")
  description Json?                       // LocalizedText — narrativa más larga
  stats       Json?                       // estructurado libre: { repos: 67, achievements: [...] }
  featured    Boolean  @default(false)    // si se destaca en el portafolio
  order       Int      @default(0)
  visible     Boolean  @default(true)

  @@index([platform])
  @@index([order])
}

// Repositorios destacados (curaduría manual; NO un dump del API de GitHub)
model FeaturedRepository {
  id           String   @id @default(cuid())
  name         String                     // nombre del repo
  url          String
  language     String?                    // ej. 'TypeScript', 'Java'
  description  Json                       // LocalizedText
  technologies String[]
  tags         String[]                   // para filtrado por perfil curado
  order        Int      @default(0)
  visible      Boolean  @default(true)
  evidence     RepositoryEvidence?

  @@index([order])
}

// ─────────────────────────────────────────────────────────────
// SISTEMA DE PERSONALIZACIÓN (THEMING)
// ─────────────────────────────────────────────────────────────
model Theme {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isPreset  Boolean  @default(false)
  tokens    Json     // design tokens completos (colors, typography, layout, effects)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  curatedProfiles CuratedProfile[]
}

// ─────────────────────────────────────────────────────────────
// PERFIL CURADO — NÚCLEO DEL PRODUCTO
// ─────────────────────────────────────────────────────────────
model CuratedProfile {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          Json       // LocalizedText { es, en }
  headline       Json       // LocalizedText { es, en }
  description    Json?      // LocalizedText { es, en }

  // Taxonomía para navegación (subclasificación del menú)
  roleType       Json?      // LocalizedText { es, en } — ej. "Tech Lead", "Backend", "Fullstack"
  techFocus      String?    // tecnología destacada — ej. ".NET", "Java", "Node / React"

  // Lógica de filtrado/curación
  filterTags     String[]   // incluir items que compartan al menos un tag
  includeIds     String[]   // override: forzar inclusión de IDs (exp/skill)
  excludeIds     String[]   // override: forzar exclusión de IDs

  // Personalización visual
  theme          Theme?     @relation(fields: [themeId], references: [id])
  themeId        String?
  themeOverrides Json?      // override parcial de tokens del tema
  layout         String     @default("classic")
  sectionsOrder  String[]   @default([])
  sectionsHidden String[]   @default([])

  // Visibilidad y acceso
  visibility     Visibility @default(PUBLIC)
  accessToken    String?    // para perfiles PROTECTED

  // Ciclo de vida (add-curated-profile-lifecycle): tres ejes disjuntos.
  // `visibility` decide quién puede abrirlo, `archivedAt` si sigue vivo
  // (archivado = 404, gana siempre) y `listed` si se enumera en listados y sitemap.
  archivedAt     DateTime?
  listed         Boolean    @default(true)
  slugAliases    CuratedProfileSlugAlias[]

  // Analítica
  views          Int        @default(0)
  profileViews   ProfileView[]
  shareLinks     ShareLink[]
  applications   Application[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([slug])
}

enum Visibility {
  PUBLIC
  PRIVATE
  PROTECTED
}

// ─────────────────────────────────────────────────────────────
// ANALÍTICA DE VISITAS
// ─────────────────────────────────────────────────────────────
/// Slug anterior de un perfil renombrado: sigue resolviendo al perfil para que
/// los links ya enviados no se rompan (add-curated-profile-lifecycle, D5).
model CuratedProfileSlugAlias {
  id               String         @id @default(cuid())
  slug             String         @unique
  curatedProfile   CuratedProfile @relation(fields: [curatedProfileId], references: [id], onDelete: Cascade)
  curatedProfileId String
  createdAt        DateTime       @default(now())

  @@index([curatedProfileId])
}

// Tipo de la visita (change classify-profile-views): solo las HUMAN suman en views y en el agregado.
// OWNER = petición con sesión de administrador válida; BOT = sin User-Agent o con uno de la lista versionada.
enum ViewKind {
  HUMAN
  OWNER
  BOT
}

model ProfileView {
  id               String          @id @default(cuid())
  curatedProfile   CuratedProfile  @relation(fields: [curatedProfileId], references: [id], onDelete: Cascade)
  curatedProfileId String
  locale           String?         // idioma servido en esta visita (es/en) — analítica sin duplicar perfil
  referrer         String?
  userAgent        String?
  ipHash           String?         // hash de IP por privacidad, nunca IP cruda
  viewedAt         DateTime        @default(now())
  kind             ViewKind        @default(HUMAN) // filas previas: HUMAN; views:reclassify las recalcula
  // Atribución (change add-share-links): el enlace de seguimiento activo y del mismo perfil que
  // trajo `?via=`, y el portal efectivo (el del enlace o `?src=` normalizado). Filas previas: nulos.
  shareLink        ShareLink?      @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  shareLinkId      String?
  source           String?

  @@index([curatedProfileId])
  @@index([viewedAt])
  @@index([shareLinkId])
  @@index([source])
}

// Tipo de enlace de seguimiento: MANUAL lo crea el owner; LINKEDIN_POST es el que reusa el botón
// «Compartir en LinkedIn».
enum ShareLinkKind {
  MANUAL
  LINKEDIN_POST
}

/// Enlace de seguimiento por destinatario o portal (`?via=<code>`). El código, el portal, el tipo y el
/// perfil no cambian; la etiqueta sí. Revocar es irreversible y solo deja de atribuir.
model ShareLink {
  id               String         @id @default(cuid())
  code             String         @unique // 10 símbolos base32 de Crockford en minúsculas
  curatedProfile   CuratedProfile @relation(fields: [curatedProfileId], references: [id], onDelete: Cascade)
  curatedProfileId String
  label            String         // escrita por el owner; 1 a 80 caracteres
  portal           String?        // normalizado como `src`
  kind             ShareLinkKind  @default(MANUAL)
  createdAt        DateTime       @default(now())
  revokedAt        DateTime?
  profileViews     ProfileView[]
  application      Application?

  @@index([curatedProfileId])
}

// ─────────────────────────────────────────────────────────────
// POSTULACIONES (CRM personal, solo panel; sin datos de contacto de personas)
// ─────────────────────────────────────────────────────────────
enum ApplicationStatus {
  DRAFT
  APPLIED
  INTERVIEWING
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Application {
  id               String            @id @default(cuid())
  company          String            // 1 a 120 caracteres
  role             String            // 1 a 160 caracteres
  jobUrl           String?           // URL http(s) de la vacante
  portal           String?           // normalizado como `src`
  notes            String?           // texto libre del owner, hasta 5000
  status           ApplicationStatus @default(DRAFT)
  appliedAt        DateTime?         @db.Date
  statusChangedAt  DateTime          @default(now())
  curatedProfile   CuratedProfile?   @relation(fields: [curatedProfileId], references: [id], onDelete: SetNull)
  curatedProfileId String?
  shareLink        ShareLink?        @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  shareLinkId      String?           @unique // un enlace, una postulación
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([updatedAt])
  @@index([curatedProfileId])
}

// ─────────────────────────────────────────────────────────────
// AUTENTICACIÓN (BACKOFFICE)
// ─────────────────────────────────────────────────────────────
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
  /// Versión de sesión: el JWT lleva `sv` y solo vale si coincide. Cambiar la contraseña la incrementa.
  sessionVersion Int @default(0)
}

// ─────────────────────────────────────────────────────────────
// INTEGRACIONES (change add-integrations-foundation): cola, estado por proveedor,
// credenciales cifradas, snapshots y arriendo del ejecutor. Sin FK hacia tablas existentes.
// ─────────────────────────────────────────────────────────────
enum IntegrationJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  DEAD
}

enum SyncRunOutcome {
  SUCCESS
  FAILED
  DEAD
  INTERRUPTED
  TIMEOUT
}

/// Una fila por proveedor: kill switch, pausa y breaker (D10). Se crea al primer uso.
model IntegrationSetting {
  provider            String    @id
  enabled             Boolean   @default(true)
  pausedUntil         DateTime?
  pauseReason         String?
  consecutiveFailures Int       @default(0)
  lastSuccessAt       DateTime?
  enabledSince        DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Secreto del proveedor cifrado con AES-256-GCM (D12). Nunca se devuelve por la API.
model IntegrationCredential {
  provider   String   @id
  ciphertext String
  keyId      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Cola de trabajos (D7). `idempotencyKey` único: encolar dos veces lo mismo deja una fila. Además, un índice
/// único PARCIAL (solo en la migración) limita a un trabajo activo por (provider, kind).
model IntegrationJob {
  id             String               @id @default(cuid())
  provider       String
  kind           String
  idempotencyKey String               @unique
  payload        Json
  status         IntegrationJobStatus @default(PENDING)
  attempts       Int                  @default(0)
  maxAttempts    Int                  @default(8)
  runAt          DateTime             @default(now())
  lockedBy       String?
  lockedUntil    DateTime?
  lastErrorClass String?
  lastError      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  finishedAt     DateTime?
  runs           SyncRun[]

  @@index([status, runAt])
  @@index([provider, status])
}

/// Un intento de un trabajo (D16).
model SyncRun {
  id           String         @id @default(cuid())
  job          IntegrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        String
  provider     String
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  outcome      SyncRunOutcome?
  errorClass   String?
  errorMessage String?
  itemsChanged Int            @default(0)
  durationMs   Int?

  @@index([provider, startedAt(sort: Desc)])
  @@index([jobId])
}

/// Último cuerpo traído de un recurso externo (D15).
model ExternalSnapshot {
  id          String   @id @default(cuid())
  provider    String
  resourceKey String
  etag        String?
  contentHash String
  body        Json
  fetchedAt   DateTime @default(now())
  changedAt   DateTime @default(now())

  @@unique([provider, resourceKey])
}

/// Arriendo del ejecutor (D4): una sola fila, `id = 'runner'`, creada por la migración.
model IntegrationRunnerLease {
  id        String   @id
  holder    String
  expiresAt DateTime
}

// ─────────────────────────────────────────────────────────────
// VACANTES IMPORTADAS (change add-job-posting-intake)
// ─────────────────────────────────────────────────────────────
enum JobPostingSourceKind {
  GREENHOUSE
  LEVER
  ASHBY
  JSON_LD
  PASTED
}

enum WorkplaceType {
  REMOTE
  HYBRID
  ONSITE
}

/// Vacante normalizada que el owner importó desde el panel. Sin relaciones con otras tablas.
/// La respuesta remota nunca se guarda: solo estos campos; `description` se borra a los 90 días.
model JobPosting {
  id                   String               @id @default(cuid())
  source               JobPostingSourceKind
  sourceKey            String               @unique
  sourceUrl            String?
  applyUrl             String?
  title                String
  company              String?
  location             String?
  workplaceType        WorkplaceType?
  employmentType       String?
  compensation         String?
  language             String?
  postedAt             DateTime?
  description          String?
  descriptionTruncated Boolean              @default(false)
  detectedTerms        String[]             @default([])
  importedAt           DateTime
  textPurgeAt          DateTime
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([importedAt])
  @@index([textPurgeAt])
}

// ─────────────────────────────────────────────────────────────
// EVIDENCIA DE CÓDIGO (change `add-github-code-evidence`)
// ─────────────────────────────────────────────────────────────
// Lo verificado contra GitHub por repositorio destacado. La escribe SOLO el conector `github`
// (modules/integrations); `featured-repository` la lee. Se borra en cascada con el repositorio.
enum RepositoryEvidenceStatus {
  OK
  NOT_FOUND
  INACCESSIBLE
  PRIVATE
}

model RepositoryEvidence {
  featuredRepositoryId String                   @id
  featuredRepository   FeaturedRepository       @relation(fields: [featuredRepositoryId], references: [id], onDelete: Cascade)
  repoKey              String                   // `owner/repo` en minúsculas, tal como se pidió al sincronizar
  status               RepositoryEvidenceStatus
  stars                Int?
  primaryLanguage      String?
  languages            Json?                    // { lenguaje: bytes }, hasta 20
  topics               String[]                 @default([])
  pushedAt             DateTime?
  archived             Boolean                  @default(false)
  isFork               Boolean                  @default(false)
  movedTo              String?                  // `full_name` si GitHub lo movió (D5)
  githubDescription    String?                  // solo para el panel
  verifiedAt           DateTime                 // última vez que GitHub respondió por este repo
  changedAt            DateTime                 // última vez que cambió el contenido
}
