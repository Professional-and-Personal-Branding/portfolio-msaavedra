# ── Backend Environment Variables ──
# Copia este archivo a .env y ajusta los valores.

# PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

# App
PORT=3000
NODE_ENV=development

# CORS (origen del frontend)
FRONTEND_URL="http://localhost:5173"

# JWT (backoffice) — generar secretos fuertes en producción
JWT_SECRET="cambiar-por-un-secreto-fuerte-en-produccion"
JWT_EXPIRES_IN="1d"

# Admin inicial (usado por un script de bootstrap opcional; NO hardcodear en prod)
ADMIN_EMAIL="saavedramanuel100@gmail.com"
ADMIN_PASSWORD="cambiar-en-primer-arranque"
