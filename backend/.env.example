# ── Backend Environment Variables ──
# Copia este archivo a .env y ajusta los valores.

# PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5434/portfolio?schema=public"

# App (3300 porque el 3000 suele estar ocupado; el proxy de Vite del frontend apunta al 3300)
PORT=3300
NODE_ENV=development

# CORS (origen del frontend)
FRONTEND_URL="http://localhost:5173"

# JWT (backoffice) — obligatorio, mínimo 16 caracteres; generar uno fuerte: openssl rand -base64 48
JWT_SECRET="cambiar-por-un-secreto-fuerte-en-produccion"
# Segundos o notación 30m / 12h / 1d
JWT_EXPIRES_IN="1d"
# Sal del hash de IP para analítica (opcional; si falta se usa JWT_SECRET).
# En producción DEBE ser distinta de JWT_SECRET.
# ANALYTICS_SALT="otra-sal-aleatoria"

# ── Producción (Fase 6) — ver docs/DEPLOY.md ──
# Nivel de log: fatal | error | warn | info | debug | trace
# LOG_LEVEL="info"

# Límite de peticiones: ventana en segundos, peticiones por IP e intentos de login
# THROTTLE_TTL=60
# THROTTLE_LIMIT=120
# THROTTLE_LOGIN_LIMIT=5

# SameSite de la cookie de sesión: strict (mismo sitio) | none (dominios distintos, exige HTTPS)
# SESSION_COOKIE_SAMESITE="lax"

# Publicar Swagger en producción (por defecto queda cerrado)
# ENABLE_API_DOCS="false"

# Admin inicial — lo crea/actualiza `npm run admin:bootstrap` (hash argon2id); NO hardcodear en prod
ADMIN_EMAIL="saavedramanuel100@gmail.com"
ADMIN_PASSWORD="cambiar-en-primer-arranque"
ADMIN_NAME="Manuel Saavedra"

# ── Integraciones (change add-integrations-foundation) ──
# Todo apagado por defecto: dejá este bloque comentado hasta que llegue un proveedor real.
# Proveedores habilitados, separados por comas (catálogo actual: `fake`, para tests y prohibido en producción, y `github`).
# INTEGRATIONS_ENABLED=""
# Enciende los timers del planificador y del ejecutor en ESTE proceso (una sola réplica). Default: false.
# INTEGRATIONS_SCHEDULER_ENABLED="false"
# Planificador diario (cron, UTC). Default: 06:00 en Bolivia.
# INTEGRATIONS_SYNC_CRON="0 10 * * *"
# Cada cuántos segundos el ejecutor busca trabajos vencidos (10 a 3600). Default: 60.
# INTEGRATIONS_TICK_SECONDS=60
# Timeout de un trabajo (5000 a 600000 ms) y duración máxima de una corrida (10000 a 1800000 ms).
# INTEGRATIONS_JOB_TIMEOUT_MS=120000
# INTEGRATIONS_RUN_MAX_MS=300000
# Keyring para cifrar credenciales guardadas desde el panel: `id:base64 de 32 bytes`, separados por comas.
# Generar una: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# La de abajo es SOLO de ejemplo: en producción el arranque la rechaza.
# INTEGRATIONS_KEYS="k1:ZWplbXBsby1OTy1VU0FSLWNsYXZlLWRlLTMyYnl0ZXM="
# INTEGRATIONS_ACTIVE_KEY="k1"
# Secreto del proveedor `fake` (OPCIONAL: si no está, se usa la credencial guardada desde el panel; si está, manda esta).
# FAKE_PROVIDER_TOKEN="token-de-prueba"
# ── Evidencia de código de GitHub (change add-github-code-evidence) ──
# Token del proveedor `github` (OPCIONAL: si no está, se usa la credencial guardada desde Integraciones; si está, manda).
# Fine-grained, "Public repositories (read-only)", sin permisos adicionales y con vencimiento. NO se llama GITHUB_TOKEN:
# es el nombre que GitHub Actions y otras herramientas inyectan por su cuenta.
# GITHUB_SYNC_TOKEN=""
# `http` (la API real; URL base fija https://api.github.com) o `fixture` (respuestas inventadas de backend/test/fixtures/github,
# solo desarrollo y pruebas; el arranque lo rechaza con NODE_ENV=production).
# GITHUB_TRANSPORT="http"
