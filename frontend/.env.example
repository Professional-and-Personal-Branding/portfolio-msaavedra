# ── Frontend Environment Variables ──
# Copia este archivo a .env.local y ajusta los valores.

# Base de la API. Vacío en desarrollo: Vite hace proxy de /api → VITE_PROXY_TARGET.
VITE_API_URL=

# Destino del proxy de desarrollo (puerto del backend local; ver backend/.env)
VITE_PROXY_TARGET=http://localhost:3300
