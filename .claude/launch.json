{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "start:dev"
      ],
      "port": 3300
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "manual",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "vite",
        "docs/manual",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}
